// ---- OTLP Receiver ----
// Receives traces, metrics, and logs from apps via OpenTelemetry SDK
otelcol.receiver.otlp "default" {
  grpc { endpoint = "0.0.0.0:4317" }
  http { endpoint = "0.0.0.0:4318" }

  output {
    traces  = [otelcol.exporter.otlphttp.tempo.input]
    metrics = [otelcol.exporter.prometheus.default.input]
    logs    = [otelcol.exporter.loki.default.input]
  }
}

// ---- Traces -> Tempo ----
otelcol.exporter.otlphttp "tempo" {
  client {
    endpoint = "http://tempo:4318"
  }
}

// ---- Metrics -> Prometheus ----
otelcol.exporter.prometheus "default" {
  forward_to = [prometheus.remote_write.default.receiver]
}

prometheus.remote_write "default" {
  endpoint {
    url = "http://prometheus:9090/api/v1/write"
  }
}

// ---- OTel Logs -> Loki ----
otelcol.exporter.loki "default" {
  forward_to = [loki.write.default.receiver]
}

loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}

// ---- Docker container log scraping ----
// Scrapes stdout/stderr from containers on the quantyx-net network
discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "containers" {
  targets = discovery.docker.containers.targets

  // Only scrape containers with names starting with "quantyx-"
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/quantyx-.+"
    action        = "keep"
  }

  // Use container name as the "service_name" label
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "service_name"
  }
}

loki.source.docker "containers" {
  host    = "unix:///var/run/docker.sock"
  targets = discovery.relabel.containers.output
  forward_to = [loki.process.pino_level.receiver]
}

// Extract Pino numeric level from JSON logs and map to standard severity.
// Sets level as structured metadata so Loki can filter without | json at query time.
loki.process "pino_level" {
  stage.json {
    expressions = { pino_level = "level" }
  }

  stage.template {
    source   = "level_name"
    template = "{{ if eq .pino_level \"10\" }}trace{{ else if eq .pino_level \"20\" }}debug{{ else if eq .pino_level \"30\" }}info{{ else if eq .pino_level \"40\" }}warn{{ else if eq .pino_level \"50\" }}error{{ else if eq .pino_level \"60\" }}critical{{ else }}unknown{{ end }}"
  }

  stage.structured_metadata {
    values = { level = "level_name" }
  }

  stage.label_drop {
    values = ["pino_level", "level_name"]
  }

  forward_to = [loki.write.default.receiver]
}
