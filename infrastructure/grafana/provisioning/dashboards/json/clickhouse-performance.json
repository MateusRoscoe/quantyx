{
  "uid": "quantyx-clickhouse",
  "title": "ClickHouse Performance",
  "tags": ["quantyx", "observability", "clickhouse"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "ds_prometheus",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "selected": true,
          "text": "Prometheus",
          "value": "prometheus"
        },
        "hide": 0
      },
      {
        "name": "ds_tempo",
        "label": "Tempo",
        "type": "datasource",
        "query": "tempo",
        "current": { "selected": true, "text": "Tempo", "value": "tempo" },
        "hide": 0
      },
      {
        "name": "ds_clickhouse",
        "label": "ClickHouse",
        "type": "datasource",
        "query": "grafana-clickhouse-datasource",
        "current": {},
        "hide": 0
      },
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${ds_prometheus}" },
        "query": "label_values(traces_spanmetrics_calls_total{db_system=\"clickhouse\"}, service)",
        "multi": true,
        "includeAll": true,
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "query_name",
        "label": "Query",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${ds_prometheus}" },
        "query": "label_values(traces_spanmetrics_calls_total{db_system=\"clickhouse\", db_query_name!=\"\"}, db_query_name)",
        "multi": true,
        "includeAll": true,
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Server Health",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "stat",
      "title": "Active Queries",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${ds_prometheus}" },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 5 },
              { "color": "red", "value": 20 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${ds_prometheus}" },
          "expr": "ClickHouseMetrics_Query{job=\"clickhouse\"}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Memory Usage",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${ds_prometheus}" },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 536870912 },
              { "color": "red", "value": 1073741824 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${ds_prometheus}" },
          "expr": "ClickHouseAsyncMetrics_MemoryResident{job=\"clickhouse\"}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "MergeTree Parts",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${ds_prometheus}" },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 500 },
              { "color": "red", "value": 1000 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${ds_prometheus}" },
          "expr": "ClickHouseAsyncMetrics_TotalPartsOfMergeTreeTables{job=\"clickhouse\"}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Background Merges",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${ds_prometheus}" },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 3 },
              { "color": "red", "value": 10 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${ds_prometheus}" },
          "expr": "ClickHouseMetrics_BackgroundMergesAndMutationsPoolTask{job=\"clickhouse\"}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Memory Over Time",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "${ds_prometheus}" },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": { "mode": "palette-classic" },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 15,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${ds_prometheus}" },
          "expr": "ClickHouseAsyncMetrics_MemoryResident{job=\"clickhouse\"}",
          "legendFormat": "Resident",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${ds_prometheus}" },
          "expr": "ClickHouseAsyncMetrics_MemoryDataAndMetadata{job=\"clickhouse\"}",
          "legendFormat": "Data + Metadata",
          "refId": "B"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Background Operations",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "${ds_prometheus}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 15,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${ds_prometheus}" },
          "expr": "ClickHouseMetrics_Merge{job=\"clickhouse\"}",
          "legendFormat": "Active Merges",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${ds_prometheus}" },
          "expr": "ClickHouseMetrics_BackgroundMergesAndMutationsPoolTask{job=\"clickhouse\"}",
          "legendFormat": "Pool Tasks",
          "refId": "B"
        }
      ]
    },
    {
      "type": "row",
      "title": "Query Performance by Name",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 11 },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Query Rate by Name",
      "description": "Queries per second grouped by db.query.name",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "${ds_prometheus}" },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": { "mode": "palette-classic" },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 15,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["mean", "max"],
          "sortBy": "Max",
          "sortDesc": true
        }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${ds_prometheus}" },
          "expr": "sum(rate(traces_spanmetrics_calls_total{db_system=\"clickhouse\", service=~\"$service\", db_query_name=~\"$query_name\", db_query_name!=\"\"}[$__rate_interval])) by (db_query_name)",
          "legendFormat": "{{db_query_name}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "P95 Latency by Name",
      "description": "95th percentile query duration grouped by db.query.name",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "${ds_prometheus}" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": { "mode": "palette-classic" },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["mean", "max"],
          "sortBy": "Max",
          "sortDesc": true
        }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${ds_prometheus}" },
          "expr": "histogram_quantile(0.95, sum(rate(traces_spanmetrics_latency_bucket{db_system=\"clickhouse\", service=~\"$service\", db_query_name=~\"$query_name\", db_query_name!=\"\"}[$__rate_interval])) by (le, db_query_name))",
          "legendFormat": "{{db_query_name}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Error Rate by Name",
      "description": "Failed queries per second",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "${ds_prometheus}" },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": { "mode": "palette-classic" },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 15,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": ".*" },
            "properties": [
              {
                "id": "color",
                "value": { "mode": "fixed", "fixedColor": "red" }
              }
            ]
          }
        ]
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["mean", "sum"],
          "sortBy": "Mean",
          "sortDesc": true
        }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${ds_prometheus}" },
          "expr": "sum(rate(traces_spanmetrics_calls_total{db_system=\"clickhouse\", service=~\"$service\", db_query_name=~\"$query_name\", status_code=\"STATUS_CODE_ERROR\"}[$__rate_interval])) by (db_query_name)",
          "legendFormat": "{{db_query_name}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "row",
      "title": "Latency Trends",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 20 },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Latency Percentiles by Query",
      "description": "P50, P95, P99 per query name to spot degradation",
      "gridPos": { "h": 8, "w": 14, "x": 0, "y": 21 },
      "datasource": { "type": "prometheus", "uid": "${ds_prometheus}" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": { "mode": "palette-classic" },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["mean", "max"],
          "sortBy": "Max",
          "sortDesc": true
        }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${ds_prometheus}" },
          "expr": "histogram_quantile(0.99, sum(rate(traces_spanmetrics_latency_bucket{db_system=\"clickhouse\", service=~\"$service\", db_query_name=~\"$query_name\", db_query_name!=\"\"}[$__rate_interval])) by (le, db_query_name))",
          "legendFormat": "{{db_query_name}} p99",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${ds_prometheus}" },
          "expr": "histogram_quantile(0.95, sum(rate(traces_spanmetrics_latency_bucket{db_system=\"clickhouse\", service=~\"$service\", db_query_name=~\"$query_name\", db_query_name!=\"\"}[$__rate_interval])) by (le, db_query_name))",
          "legendFormat": "{{db_query_name}} p95",
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${ds_prometheus}" },
          "expr": "histogram_quantile(0.50, sum(rate(traces_spanmetrics_latency_bucket{db_system=\"clickhouse\", service=~\"$service\", db_query_name=~\"$query_name\", db_query_name!=\"\"}[$__rate_interval])) by (le, db_query_name))",
          "legendFormat": "{{db_query_name}} p50",
          "refId": "C"
        }
      ]
    },
    {
      "type": "heatmap",
      "title": "Query Duration Distribution",
      "gridPos": { "h": 8, "w": 10, "x": 14, "y": 21 },
      "datasource": { "type": "prometheus", "uid": "${ds_prometheus}" },
      "options": {
        "calculate": false,
        "color": { "scheme": "Oranges", "mode": "scheme" },
        "yAxis": { "unit": "s" },
        "tooltip": { "show": true, "yHistogram": true },
        "cellGap": 1
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${ds_prometheus}" },
          "expr": "sum(increase(traces_spanmetrics_latency_bucket{db_system=\"clickhouse\", service=~\"$service\"}[$__rate_interval])) by (le)",
          "legendFormat": "{{le}}",
          "format": "heatmap",
          "refId": "A"
        }
      ]
    },
    {
      "type": "row",
      "title": "Slow & Error Queries",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 29 },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "table",
      "title": "Slow Queries (> 500ms)",
      "description": "Individual ClickHouse spans exceeding 500ms. Click trace ID to view full trace.",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 30 },
      "datasource": { "type": "tempo", "uid": "${ds_tempo}" },
      "options": {
        "showHeader": true,
        "sortBy": [{ "displayName": "Duration", "desc": true }]
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          { "matcher": { "id": "byName", "options": "nested" }, "properties": [{ "id": "custom.hidden", "value": true }] }
        ]
      },
      "targets": [
        {
          "datasource": { "type": "tempo", "uid": "${ds_tempo}" },
          "queryType": "traceql",
          "query": "{span.db.system = \"clickhouse\" && duration > 500ms} | select(span.db.query.name, span.db.operation.name, span.db.statement)",
          "limit": 20,
          "refId": "A"
        }
      ]
    },
    {
      "type": "table",
      "title": "Error Queries",
      "description": "Failed ClickHouse queries",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 40 },
      "datasource": { "type": "tempo", "uid": "${ds_tempo}" },
      "options": {
        "showHeader": true,
        "sortBy": [{ "displayName": "Start time", "desc": true }]
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          { "matcher": { "id": "byName", "options": "nested" }, "properties": [{ "id": "custom.hidden", "value": true }] }
        ]
      },
      "targets": [
        {
          "datasource": { "type": "tempo", "uid": "${ds_tempo}" },
          "queryType": "traceql",
          "query": "{span.db.system = \"clickhouse\" && status = error} | select(span.db.query.name, span.db.operation.name, span.db.statement)",
          "limit": 20,
          "refId": "A"
        }
      ]
    },
    {
      "type": "row",
      "title": "Server-Side Analysis (system.query_log)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 50 },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Server-Side P95 Query Duration",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 51 },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "${ds_clickhouse}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "color": { "mode": "palette-classic" },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "${ds_clickhouse}"
          },
          "editorType": "sql",
          "format": 0,
          "rawSql": "SELECT toStartOfMinute(event_time) AS time, quantile(0.95)(query_duration_ms) AS p95, quantile(0.50)(query_duration_ms) AS p50 FROM system.query_log WHERE type = 'QueryFinish' AND is_initial_query = 1 AND query_kind = 'Select' AND event_time >= $__fromTime AND event_time <= $__toTime GROUP BY time ORDER BY time",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Avg Read Rows & Bytes",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 51 },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "${ds_clickhouse}"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "avg_bytes" },
            "properties": [
              { "id": "custom.axisPlacement", "value": "right" },
              { "id": "unit", "value": "bytes" }
            ]
          }
        ]
      },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "${ds_clickhouse}"
          },
          "editorType": "sql",
          "format": 0,
          "rawSql": "SELECT toStartOfMinute(event_time) AS time, avg(read_rows) AS avg_rows, avg(read_bytes) AS avg_bytes FROM system.query_log WHERE type = 'QueryFinish' AND is_initial_query = 1 AND query_kind = 'Select' AND event_time >= $__fromTime AND event_time <= $__toTime GROUP BY time ORDER BY time",
          "refId": "A"
        }
      ]
    },
    {
      "type": "table",
      "title": "Top Queries by Memory",
      "description": "Heaviest queries by average memory usage, grouped by normalized query hash",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 59 },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "${ds_clickhouse}"
      },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "options": {
        "showHeader": true,
        "sortBy": [{ "displayName": "avg_memory", "desc": true }]
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "${ds_clickhouse}"
          },
          "editorType": "sql",
          "format": 1,
          "rawSql": "SELECT normalized_query_hash, substring(any(query), 1, 120) AS query_preview, formatReadableSize(avg(memory_usage)) AS avg_memory, count() AS executions, round(quantile(0.95)(query_duration_ms)) AS p95_ms, round(avg(read_rows)) AS avg_read_rows FROM system.query_log WHERE type = 'QueryFinish' AND is_initial_query = 1 AND event_time >= $__fromTime AND event_time <= $__toTime GROUP BY normalized_query_hash ORDER BY avg(memory_usage) DESC LIMIT 15",
          "refId": "A"
        }
      ]
    },
    {
      "type": "table",
      "title": "Slowest Individual Queries",
      "description": "Individual slowest queries with full details",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 59 },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "${ds_clickhouse}"
      },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "options": {
        "showHeader": true,
        "sortBy": [{ "displayName": "duration_ms", "desc": true }]
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "${ds_clickhouse}"
          },
          "editorType": "sql",
          "format": 1,
          "rawSql": "SELECT event_time, query_duration_ms AS duration_ms, formatReadableQuantity(read_rows) AS read_rows, formatReadableSize(read_bytes) AS read_bytes, formatReadableSize(memory_usage) AS memory, substring(query, 1, 150) AS query_preview FROM system.query_log WHERE type = 'QueryFinish' AND is_initial_query = 1 AND event_time >= $__fromTime AND event_time <= $__toTime ORDER BY query_duration_ms DESC LIMIT 20",
          "refId": "A"
        }
      ]
    },
    {
