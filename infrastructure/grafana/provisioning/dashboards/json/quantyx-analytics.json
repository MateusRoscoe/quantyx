      "targets": [
        {
          "datasource": { "type": "grafana-clickhouse-datasource", "uid": "" },
          "editorType": "sql",
          "format": 1,
          "rawSql": "SELECT project_id, user_id, minMerge(first_seen) AS first_seen, maxMerge(last_seen) AS last_seen, sumMerge(total_events) AS total_events FROM analytics.users GROUP BY project_id, user_id ORDER BY total_events DESC LIMIT 50",
