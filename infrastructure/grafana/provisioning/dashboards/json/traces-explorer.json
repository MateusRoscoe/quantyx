{
  "uid": "quantyx-traces",
  "title": "Traces Explorer",
  "tags": ["quantyx", "observability", "traces"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "ds_prometheus",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": { "selected": true, "text": "Prometheus", "value": "prometheus" },
        "hide": 0
      },
      {
        "name": "ds_tempo",
        "label": "Tempo",
        "type": "datasource",
        "query": "tempo",
        "current": { "selected": true, "text": "Tempo", "value": "tempo" },
        "hide": 0
      },
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${ds_prometheus}" },
        "query": "label_values(traces_service_graph_request_total, client)",
        "multi": true,
        "includeAll": true,
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Service Graph",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "nodeGraph",
      "title": "Service Map",
      "description": "Service dependency graph built from span metrics. Requires Tempo metrics_generator.",
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 1 },
      "datasource": { "type": "tempo", "uid": "${ds_tempo}" },
      "targets": [
        {
          "datasource": { "type": "tempo", "uid": "${ds_tempo}" },
          "queryType": "serviceMap",
          "serviceMapQuery": "",
          "refId": "A"
        }
      ]
    },
    {
      "type": "row",
      "title": "Span Metrics",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 13 },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Request Rate (service graph)",
      "description": "Requests per second between services, from Tempo span metrics",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "${ds_prometheus}" },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 15, "showPoints": "never", "spanNulls": true }
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean"] }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${ds_prometheus}" },
          "expr": "sum(rate(traces_service_graph_request_total{client=~\"$service\"}[$__rate_interval])) by (client, server)",
          "legendFormat": "{{client}} -> {{server}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Error Rate (service graph)",
      "description": "Failed requests per second between services",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "${ds_prometheus}" },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 15, "showPoints": "never", "spanNulls": true }
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean"] }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${ds_prometheus}" },
          "expr": "sum(rate(traces_service_graph_request_failed_total{client=~\"$service\"}[$__rate_interval])) by (client, server)",
          "legendFormat": "{{client}} -> {{server}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "P95 Latency (service graph)",
      "description": "95th percentile latency between services",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "${ds_prometheus}" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 0, "showPoints": "never", "spanNulls": true }
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${ds_prometheus}" },
          "expr": "histogram_quantile(0.95, sum(rate(traces_service_graph_request_server_seconds_bucket{server=~\"$service\"}[$__rate_interval])) by (le, client, server))",
          "legendFormat": "{{client}} -> {{server}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "row",
      "title": "Trace Search",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 22 },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "table",
      "title": "Recent Traces",
      "description": "Search traces via TraceQL. Click a Trace ID to view the full trace.",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 23 },
      "datasource": { "type": "tempo", "uid": "${ds_tempo}" },
      "options": {
        "showHeader": true,
        "sortBy": [{ "displayName": "Start time", "desc": true }]
      },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "tempo", "uid": "${ds_tempo}" },
          "queryType": "traceql",
          "query": "{}",
          "limit": 20,
          "refId": "A"
        }
      ]
    },
    {
      "type": "table",
      "title": "Error Traces",
      "description": "Traces with error status",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 33 },
      "datasource": { "type": "tempo", "uid": "${ds_tempo}" },
      "options": {
        "showHeader": true,
        "sortBy": [{ "displayName": "Start time", "desc": true }]
      },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "tempo", "uid": "${ds_tempo}" },
          "queryType": "traceql",
          "query": "{status = error}",
          "limit": 20,
          "refId": "A"
        }
      ]
    }
  ],
  "annotations": { "list": [] },
  "links": [
    { "title": "Services Overview", "type": "link", "icon": "dashboard", "url": "/d/quantyx-services", "tooltip": "View RED metrics" },
    { "title": "Logs Explorer", "type": "link", "icon": "doc", "url": "/d/quantyx-logs", "tooltip": "View application logs" }
  ]
}
