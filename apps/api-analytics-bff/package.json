{
  "name": "@quantyx/api-analytics-bff",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "name": "api-analytics-bff",
    "targets": {
      "build": {
        "executor": "@nx/esbuild:esbuild",
        "outputs": [
          "{options.outputPath}"
        ],
        "defaultConfiguration": "production",
        "options": {
          "platform": "node",
          "outputPath": "apps/api-analytics-bff/dist",
          "format": [
            "cjs"
          ],
          "bundle": false,
          "main": "apps/api-analytics-bff/src/main.ts",
          "tsConfig": "apps/api-analytics-bff/tsconfig.app.json",
          "assets": [
            "apps/api-analytics-bff/src/assets"
          ],
          "esbuildConfig": "tools/esbuild/prisma-cjs-fix.js",
          "sourcemap": true
        },
        "configurations": {
          "development": {},
          "production": {
            "generateLockfile": true,
            "sourcemap": false
          }
        }
      },
      "prune-lockfile": {
        "dependsOn": ["build"],
        "cache": true,
        "executor": "@nx/js:prune-lockfile",
        "outputs": [
          "{workspaceRoot}/apps/api-analytics-bff/dist/package.json",
          "{workspaceRoot}/apps/api-analytics-bff/dist/pnpm-lock.yaml"
        ],
        "options": {
          "buildTarget": "build"
        }
      },
      "copy-workspace-modules": {
        "dependsOn": ["build"],
        "cache": true,
        "outputs": [
          "{workspaceRoot}/apps/api-analytics-bff/dist/workspace_modules"
        ],
        "executor": "@nx/js:copy-workspace-modules",
        "options": {
          "buildTarget": "build"
        }
      },
      "prune": {
        "dependsOn": ["prune-lockfile", "copy-workspace-modules"],
        "executor": "nx:noop"
      },
      "docker:build": {
        "dependsOn": ["build", "prune"]
      },
      "serve": {
        "continuous": true,
        "executor": "@nx/js:node",
        "defaultConfiguration": "development",
        "dependsOn": [
          "build"
        ],
        "options": {
          "buildTarget": "api-analytics-bff:build",
          "runBuildTargetDependencies": false
        },
        "configurations": {
          "development": {
            "buildTarget": "api-analytics-bff:build:development"
          },
          "production": {
            "buildTarget": "api-analytics-bff:build:production"
          }
        }
      }
    }
  },
  "dependencies": {
    "@clickhouse/client": "^1.18.2",
    "@fastify/autoload": "~6.3.1",
    "@fastify/cors": "^11.2.0",
    "@fastify/sensible": "~6.0.4",
    "@fastify/swagger": "~9.7.0",
    "@fastify/swagger-ui": "~5.2.5",
    "@prisma/adapter-pg": "^7.6.0",
    "@prisma/client": "^7.6.0",
    "better-auth": "^1.5.6",
    "fastify": "~5.8.4",
    "ioredis": "^5.10.1",
    "fastify-plugin": "~5.1.0",
    "fastify-type-provider-zod": "~6.1.0",
    "nodemailer": "^8.0.4",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@quantyx/auth": "workspace:*",
    "@quantyx/clickhouse": "workspace:*",
    "@quantyx/postgres": "workspace:*",
    "@quantyx/redis": "workspace:*",
    "@quantyx/shared": "workspace:*",
    "@quantyx/shared-backend": "workspace:*"
  }
}
