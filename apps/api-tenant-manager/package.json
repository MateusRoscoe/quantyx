{
  "name": "@quantyx/api-tenant-manager",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "name": "api-tenant-manager",
    "targets": {
      "build": {
        "executor": "@nx/esbuild:esbuild",
        "outputs": [
          "{options.outputPath}"
        ],
        "defaultConfiguration": "production",
        "options": {
          "platform": "node",
          "outputPath": "apps/api-tenant-manager/dist",
          "format": [
            "cjs"
          ],
          "bundle": false,
          "main": "apps/api-tenant-manager/src/main.ts",
          "tsConfig": "apps/api-tenant-manager/tsconfig.app.json",
          "assets": [
            "apps/api-tenant-manager/src/assets"
          ],
          "esbuildConfig": "tools/esbuild/prisma-cjs-fix.js",
          "sourcemap": true
        },
        "configurations": {
          "development": {},
          "production": {
            "sourcemap": false
          }
        }
      },
      "prune-lockfile": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "executor": "@nx/js:prune-lockfile",
        "outputs": [
          "{workspaceRoot}/apps/api-tenant-manager/dist/package.json",
          "{workspaceRoot}/apps/api-tenant-manager/dist/pnpm-lock.yaml"
        ],
        "options": {
          "buildTarget": "build"
        }
      },
      "copy-workspace-modules": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "outputs": [
          "{workspaceRoot}/apps/api-tenant-manager/dist/workspace_modules"
        ],
        "executor": "@nx/js:copy-workspace-modules",
        "options": {
          "buildTarget": "build"
        }
      },
      "prune": {
        "dependsOn": [
          "prune-lockfile",
          "copy-workspace-modules"
        ],
        "executor": "nx:noop"
      },
      "serve": {
        "continuous": true,
        "executor": "@nx/js:node",
        "defaultConfiguration": "development",
        "dependsOn": [
          "build"
        ],
        "options": {
          "buildTarget": "api-tenant-manager:build",
          "runBuildTargetDependencies": false,
          "runtimeArgs": [
            "--import",
            "@quantyx/otel/register"
          ]
        },
        "configurations": {
          "development": {
            "buildTarget": "api-tenant-manager:build:development"
          },
          "production": {
            "buildTarget": "api-tenant-manager:build:production"
          }
        }
      },
      "docker:build": {
        "dependsOn": [
          "build",
          "prune"
        ]
      }
    }
  },
  "dependencies": {
    "@fastify/autoload": "~6.3.1",
    "@fastify/cors": "^11.2.0",
    "@fastify/otel": "^0.18.0",
    "@fastify/sensible": "~6.0.4",
    "@fastify/swagger": "~9.7.0",
    "@fastify/swagger-ui": "~5.2.5",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.72.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.214.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.214.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.214.0",
    "@opentelemetry/resources": "^2.6.1",
    "@opentelemetry/sdk-logs": "^0.214.0",
    "@opentelemetry/sdk-metrics": "^2.6.1",
    "@opentelemetry/sdk-node": "^0.214.0",
    "@opentelemetry/semantic-conventions": "^1.40.0",
    "@prisma/adapter-pg": "^7.6.0",
    "@prisma/client": "^7.6.0",
    "better-auth": "^1.5.6",
    "fastify": "~5.8.4",
    "ioredis": "^5.10.1",
    "fastify-plugin": "~5.1.0",
    "fastify-type-provider-zod": "~6.1.0",
    "nodemailer": "^8.0.4",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "pino-opentelemetry-transport": "^3.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@quantyx/auth": "workspace:*",
    "@quantyx/postgres": "workspace:*",
    "@quantyx/redis": "workspace:*",
    "@quantyx/shared": "workspace:*",
    "@quantyx/shared-backend": "workspace:*",
    "@quantyx/otel": "workspace:*"
  }
}
