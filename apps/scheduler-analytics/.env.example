# ClickHouse connection (defaults match docker-compose.yaml)
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=analytics

# Scheduler mode: "daemon" (runs 24/7 with interval) or "oneshot" (runs once and exits)
SCHEDULER_MODE=daemon

# Interval between runs in daemon mode (milliseconds, default: 1 hour)
SCHEDULER_INTERVAL_MS=3600000

# Logging
LOG_LEVEL=info
