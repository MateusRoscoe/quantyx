{
  "name": "@quantyx/scheduler-analytics",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "name": "scheduler-analytics",
    "targets": {
      "build": {
        "executor": "@nx/esbuild:esbuild",
        "outputs": [
          "{options.outputPath}"
        ],
        "defaultConfiguration": "production",
        "options": {
          "platform": "node",
          "outputPath": "apps/scheduler-analytics/dist",
          "format": [
            "cjs"
          ],
          "bundle": false,
          "main": "apps/scheduler-analytics/src/main.ts",
          "tsConfig": "apps/scheduler-analytics/tsconfig.app.json",
          "assets": [],
          "esbuildOptions": {
            "sourcemap": true,
            "outExtension": {
              ".js": ".js"
            }
          }
        },
        "configurations": {
          "development": {},
          "production": {
            "generateLockfile": true,
            "esbuildOptions": {
              "sourcemap": false,
              "outExtension": {
                ".js": ".js"
              }
            }
          }
        }
      },
      "prune-lockfile": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "executor": "@nx/js:prune-lockfile",
        "outputs": [
          "{workspaceRoot}/apps/scheduler-analytics/dist/package.json",
          "{workspaceRoot}/apps/scheduler-analytics/dist/pnpm-lock.yaml"
        ],
        "options": {
          "buildTarget": "build"
        }
      },
      "copy-workspace-modules": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "outputs": [
          "{workspaceRoot}/apps/scheduler-analytics/dist/workspace_modules"
        ],
        "executor": "@nx/js:copy-workspace-modules",
        "options": {
          "buildTarget": "build"
        }
      },
      "prune": {
        "dependsOn": [
          "prune-lockfile",
          "copy-workspace-modules"
        ],
        "executor": "nx:noop"
      },
      "serve": {
        "continuous": true,
        "executor": "@nx/js:node",
        "defaultConfiguration": "development",
        "dependsOn": [
          "build"
        ],
        "options": {
          "buildTarget": "scheduler-analytics:build",
          "runBuildTargetDependencies": false,
          "runtimeArgs": [
            "--import",
            "@quantyx/otel/register"
          ]
        },
        "configurations": {
          "development": {
            "buildTarget": "scheduler-analytics:build:development"
          },
          "production": {
            "buildTarget": "scheduler-analytics:build:production"
          }
        }
      },
      "docker:build": {
        "dependsOn": [
          "build",
          "prune"
        ]
      }
    }
  },
  "dependencies": {
    "@clickhouse/client": "^1.18.2",
    "pino": "^10.3.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@quantyx/clickhouse": "workspace:*",
    "@quantyx/shared-backend": "workspace:*",
    "@quantyx/otel": "workspace:*"
  }
}
