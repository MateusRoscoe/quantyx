{
  "name": "@quantyx/postgres",
  "version": "0.0.1",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "nx": {
    "name": "postgres",
    "targets": {
      "prisma-generate": {
        "executor": "nx:run-commands",
        "options": {
          "command": "prisma generate",
          "cwd": "libs/postgres"
        }
      },
      "prisma-migrate": {
        "executor": "nx:run-commands",
        "options": {
          "command": "prisma migrate dev",
          "cwd": "libs/postgres"
        }
      },
      "prisma-studio": {
        "executor": "nx:run-commands",
        "options": {
          "command": "prisma studio",
          "cwd": "libs/postgres"
        }
      }
    }
  },
  "dependencies": {}
}
