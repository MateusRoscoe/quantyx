{
  "name": "@quantyx/auth",
  "version": "0.0.1",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "nx": {
    "name": "auth",
    "targets": {
      "generate": {
        "executor": "nx:run-commands",
        "options": {
          "command": "@better-auth/cli generate",
          "cwd": "libs/auth"
        }
      }
    }
  },
  "dependencies": {},
  "devDependencies": {
    "@quantyx/postgres": "workspace:*"
  }
}
